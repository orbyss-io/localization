<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Bounded CSV, JSON, XLSX, XLIFF 2.1, and PO localization import and export adapters.</Description>
    <PackageId>Orbyss.Localization.Formats</PackageId>
    <PackageTags>orbyss;localization;i18n;csv;xlsx;xliff;po;json</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CShells.Abstractions" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <ProjectReference Include="../Orbyss.Localization.Abstractions/Orbyss.Localization.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
